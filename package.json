{
  "name": "root",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "----@carefrees/form-utils----": "--------start-------",
    "build:edit-table": "npm run-script build --workspace @carefrees/antd-edit-table",
    "watch:edit-table": "npm run-script watch --workspace @carefrees/antd-edit-table",
    "build:all": "npm run build:edit-table",
    "build:docs": "npm run-script build --workspace docs",
    "start:docs": "npm run-script dev --workspace docs",
    "version": "lerna version --force-publish=* --no-changelog --no-git-tag-version --no-push",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\""
  },
  "dependencies": {
    "@carefrees/rslib": "~0.1.1",
    "husky": "~9.1.7",
    "lerna": "~9.0.3",
    "prettier": "~3.8.0",
    "pretty-quick": "~4.2.2",
    "lint-staged": "~16.2.7",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7"
  },
  "resolutions": {
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,tsx,ts,less,md,json}": "prettier --write"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ]
}